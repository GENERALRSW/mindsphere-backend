{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT)"
  },
  "deploy": {
    "startCommand": "bash -lc 'cd railway_api && uvicorn main:app --host 0.0.0.0 --port $PORT'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
